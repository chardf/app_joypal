<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".ui.settings">

    <!-- 标题 -->
    <TextView
        android:id="@+id/settings_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Settings"
        android:textSize="24sp"
        android:textColor="#5C4B51"
        android:layout_marginTop="200dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 清除按钮 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_clear"
        android:layout_width="300dp"
        android:layout_height="58dp"
        android:layout_marginTop="40dp"
        android:text="@string/button_clear"
        app:backgroundTint="#6A62B7"
        app:cornerRadius="29dp"
        app:iconPadding="8dp"
        app:rippleColor="#80FFFFFF"
        app:strokeColor="#2C2C2C"
        app:strokeWidth="2dp"
        android:textAppearance="@style/button"
        app:layout_constraintTop_toBottomOf="@id/settings_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 测试按钮 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/test_button"
        android:layout_width="300dp"
        android:layout_height="58dp"
        android:layout_marginTop="16dp"
        android:text="View Your Roles"
        app:backgroundTint="#6A62B7"
        app:cornerRadius="29dp"
        app:iconPadding="8dp"
        app:rippleColor="#80FFFFFF"
        app:strokeColor="#2C2C2C"
        app:strokeWidth="2dp"
        android:textAppearance="@style/button"
        app:layout_constraintTop_toBottomOf="@id/button_clear"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 修改密码按钮 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_change_password"
        android:layout_width="300dp"
        android:layout_height="58dp"
        android:layout_marginTop="16dp"
        android:text="Change Password"
        app:backgroundTint="#6A62B7"
        app:cornerRadius="29dp"
        app:iconPadding="8dp"
        app:rippleColor="#80FFFFFF"
        app:strokeColor="#2C2C2C"
        app:strokeWidth="2dp"
        android:textAppearance="@style/button"
        app:layout_constraintTop_toBottomOf="@id/test_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 退出登录按钮 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/logout_button"
        android:layout_width="300dp"
        android:layout_height="58dp"
        android:layout_marginTop="16dp"
        android:text="Logout"
        app:backgroundTint="#FF4444"
        app:cornerRadius="29dp"
        app:iconPadding="8dp"
        app:rippleColor="#80FFFFFF"
        app:strokeColor="#2C2C2C"
        app:strokeWidth="2dp"
        android:textAppearance="@style/button"
        app:layout_constraintTop_toBottomOf="@id/button_change_password"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 分割线 -->

    <!-- 底部导航栏 -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        style="@style/BottomNavigationViewStyle"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        app:backgroundTint="#FFFFFF"
        app:labelVisibilityMode="unlabeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/bottom_nav_menu" >

        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="#CCCCCC" />
    </com.google.android.material.bottomnavigation.BottomNavigationView>

</androidx.constraintlayout.widget.ConstraintLayout>