<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".ui.getstart">

    <!-- TextView -->

    <!-- 输入框容器 -->


    <!-- 底部导航栏 -->

    <TextView
        android:id="@+id/create_describe"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_marginTop="108dp"
        android:gravity="center"
        android:shadowColor="#40000000"
        android:shadowDx="0"
        android:shadowDy="4"
        android:shadowRadius="4"
        android:text="PERSONALITY"
        android:textAppearance="@style/joypal2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/let_s_set_j"
        android:layout_width="400dp"
        android:layout_height="28dp"
        android:layout_marginTop="28dp"
        android:gravity="center_horizontal|top"
        android:lineSpacingExtra="8sp"
        android:shadowColor="#40000000"
        android:shadowDx="0"
        android:shadowDy="4"
        android:shadowRadius="4"
        android:text="Let’s set JoyPal’s personality!"
        android:textAppearance="@style/let_s_set_j"
        android:translationY="-20sp"
        app:layout_constraintTop_toBottomOf="@id/create_describe"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteX="11dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="84dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/create_describe">

        <!-- 输入框 1 -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/input_layout_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <EditText
                android:id="@+id/nameEditText"
                android:layout_width="340dp"
                android:layout_height="50dp"
                android:layout_marginBottom="10dp"
                android:hint="What's JoyPal's Name?"
                android:maxLength="30"
                android:padding="10dp"
                android:textColor="@android:color/black"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="#6A62B7" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 输入框 2 -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/lookEditText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <EditText
                android:id="@+id/look"
                android:layout_width="340dp"
                android:layout_height="50dp"
                android:layout_marginBottom="10dp"
                android:hint="What does JoyPal look like?"
                android:maxLength="30"
                android:padding="10dp"
                android:textColor="@android:color/black"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="#6A62B7" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 输入框 3 -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/genderEditText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <EditText
                android:id="@+id/gender"
                android:layout_width="340dp"
                android:layout_height="50dp"
                android:layout_marginBottom="10dp"
                android:hint="What's JoyPal's Gender?"
                android:maxLength="30"
                android:padding="10dp"
                android:textColor="@android:color/black"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="#6A62B7" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 输入框 4 -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/personalityEditText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <EditText
                android:id="@+id/personality"
                android:layout_width="340dp"
                android:layout_height="50dp"
                android:layout_marginBottom="10dp"
                android:hint="What's JoyPal's Personality?"
                android:maxLength="30"
                android:padding="10dp"
                android:textColor="@android:color/black"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="#6A62B7" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- MaterialButton -->
        <TextView
            android:id="@+id/upload_reference_image"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:minHeight="48dp"
            android:padding="8dp"
            android:text="@string/upload_reference_image"
            android:textColor="#2A9DCE"
            android:textSize="14sp"
            android:textStyle="normal"
            android:visibility="visible" />

        <LinearLayout
            android:id="@+id/image_preview_container"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/delete_reference_image"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/delete_reference_image"
                android:src="@drawable/bin" />

            <TextView
                android:id="@+id/reference_image_filename"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:singleLine="true"
                android:textColor="@android:color/darker_gray" />

            <TextView
                android:id="@+id/change_reference_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/change_picture"
                android:textColor="#2A9DCE"
                android:textSize="14sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_design2"
            android:layout_width="300dp"
            android:layout_height="58dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="#6A62B7"
            android:enabled="false"
            android:text="@string/button_next"
            android:textAppearance="@style/button"
            android:textColor="@android:color/white"
            app:cornerRadius="29dp"
            app:iconPadding="8dp"
            app:rippleColor="#80FFFFFF"
            app:strokeColor="#2C2C2C"
            app:strokeWidth="2dp" /> <!-- 字体始终是白色 -->

        <!-- Upload reference image TextView -->

        <!-- TextView -->
        <TextView
            android:id="@+id/create_describe2"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginTop="15dp"
            android:gravity="center"
            android:text="@string/create_describe2"
            android:textAppearance="@style/create_describe2" />

        <!-- MaterialButton -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/skip"
            android:layout_width="100dp"
            android:layout_height="50dp"
            android:layout_marginTop="2dp"
            android:backgroundTint="#6A62B7"
            android:text="@string/button_skip"
            android:textAppearance="@style/button"
            app:cornerRadius="29dp"
            app:iconPadding="8dp"
            app:rippleColor="#80FFFFFF"
            app:strokeColor="#2C2C2C"
            app:strokeWidth="2dp" />
    </LinearLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        style="@style/BottomNavigationViewStyle"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        app:backgroundTint="#FFFFFF"
        app:labelVisibilityMode="unlabeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/bottom_nav_menu" />
    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="#CCCCCC"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />
</androidx.constraintlayout.widget.ConstraintLayout>
